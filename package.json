{
  "name": "proofhire-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "ProofHire — AI-Powered Decentralized Credential Verification & Recruitment Platform",
  "workspaces": [
    "apps/*",
    "services/api",
    "packages/*",
    "blockchain"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:all": "concurrently \"npm run dev --workspace=apps/web\" \"npm run start:dev --workspace=services/api\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run start:dev --workspace=services/api",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=services/api",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:ai": "powershell -Command \"cd services/ai; if (Test-Path .venv/Scripts/python.exe) { .venv/Scripts/python.exe -m unittest app/tests/test_ai_suite.py } else { python -m unittest app/tests/test_ai_suite.py }\"",
    "test:e2e": "npx tsx scripts/test-e2e-pipeline.ts",
    "demo:verify": "npx tsx scripts/verify-demo-scenario.ts",
    "health": "powershell -ExecutionPolicy Bypass -File scripts/health-check.ps1",
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-dev.ps1",
    "deploy:blockchain": "npm run deploy:local --workspace=@proofhire/blockchain",
    "seed:db": "npx prisma db seed --schema=services/api/prisma/schema.prisma",
    "reset:demo": "powershell -ExecutionPolicy Bypass -File scripts/reset-demo-data.ps1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
